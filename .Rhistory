group_by(NAME_1) %>%
summarise(geometry = st_union(geometry)) %>%
ungroup()
print(paste("N Rows adm1_combine_sf: ", nrow(adm1_combine_sf), "\nN Rows adm1_union_sf: ", nrow(adm1_union_sf)))
