# Make average
ntl_avg_r <- mean(ntl_r)
ntl_avg_r
ntl_avg_log_r <- log(ntl_avg_r)
ntl_avg_log_r
plot(ntl_avg_log_r)
# Plot
plot(ntl_avg_log_r)
ggplot() +
