# Prep Data for Trainings
library(here)
library(tidyverse)
library(sf)
library(terra)
library(readxl)
gf_df <- read_xlsx(here("data", "gas_flaring", "rawdata",
"2012-2024-Flare-Volume-Estimates-by-individual-Flare-Location.xlsx"))
head(gf_df)
gf_df <- gf_df %>%
clean_names()
library(janitor)
gf_df <- read_xlsx(here("data", "gas_flaring", "rawdata",
"2012-2024-Flare-Volume-Estimates-by-individual-Flare-Location.xlsx"))
gf_df <- gf_df %>%
clean_names()
saveRDS(gf_df, here("data", "gas_flaring", "finaldata", "gas_flaring.Rds"))
gf_df$country
gf_df$country %>% table()
gf_df$country %>% table() %>% View()
saveRDS(gf_df %>%
dplyr::filter(country == "Nigeria"),
here("data", "gas_flaring", "finaldata", "gas_flaring_nga.Rds"))
# Prep Data for Trainings
library(here)
library(tidyverse)
library(sf)
library(terra)
library(readxl)
library(janitor)
gf_df <- read_xlsx(here("data", "gas_flaring", "rawdata",
"2012-2024-Flare-Volume-Estimates-by-individual-Flare-Location.xlsx"))
gf_df <- gf_df %>%
clean_names()
saveRDS(gf_df, here("data", "gas_flaring", "finaldata", "gas_flaring.Rds"))
write_csv(gf_df %>%
dplyr::filter(country == "Nigeria"),
here("data", "gas_flaring", "finaldata", "gas_flaring_nga.csv"))
head(gf_df)
gf_sf <- gf_df %>%
st_as_sf(coords = c("longitude", "latitude"),
crs = 4326)
ggplot() +
geom_sf(data = gf_sf)
