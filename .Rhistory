map_df(times_vec[10], query_google, "drivingaaaa", key)
query_google <- function(time_i, mode_i, key){
message(time_i)
unix_time <- time_i %>% as.numeric()
out <- paste0(
"https://maps.googleapis.com/maps/api/directions/json?",
"origin=42.37336337116552,-71.11896726850208&",
"destination=42.334704650323786,-71.10343070927476&",
"mode=",mode_i,"&",
"departure_time=", unix_time, "&",
"key=", key
)
out_df <- fromJSON(out)
out_df$routes$legs[[1]]$distance
out_df$routes$legs[[1]]$duration_in_traffic
out_df$routes$legs[[1]]$duration
distance <- out_df$routes$legs[[1]]$distance$value
if(mode_i %in% c("walking", "transit")){
duration <- out_df$routes$legs[[1]]$duration$value
}
if(mode_i %in% c("driving", "bicycling")){
duration <- out_df$routes$legs[[1]]$duration_in_traffic$value
}
return(data.frame(datetime = time_i,
mode = mode_i,
distance_meters = distance,
duration_seconds = duration))
}
