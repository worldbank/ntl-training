query_google <- function(time_i, mode_i, key){
message(time_i)
unix_time <- time_i %>% as.numeric()
out <- paste0(
"https://maps.googleapis.com/maps/api/directions/json?",
"origin=42.37336337116552,-71.11896726850208&",
"destination=42.334704650323786,-71.10343070927476&",
"mode=",mode_i,"&",
"departure_time=", unix_time, "&",
"key=", key
)
out_df <- fromJSON(out)
# out_df$routes$legs[[1]]$distance
# out_df$routes$legs[[1]]$duration_in_traffic
# out_df$routes$legs[[1]]$duration
distance <- out_df$routes$legs[[1]]$distance$value
if(mode_i %in% c("walking", "transit", "bicycling")){
duration <- out_df$routes$legs[[1]]$duration$value
}
if(mode_i %in% c("driving")){
duration <- out_df$routes$legs[[1]]$duration_in_traffic$value
}
return(data.frame(datetime = time_i,
mode = mode_i,
distance_meters = distance,
duration_seconds = duration))
}
times_vec <- seq.POSIXt(
from = as.POSIXct("2025-10-08 00:00:00"),
to   = as.POSIXct("2025-10-08 23:59:00"),
by   = "15 mins"
)
driving_df <- map_df(times_vec, query_google, "driving", key)
biking_df <- map_df(times_vec, query_google, "bicycling", key)
walking_df <- map_df(times_vec, query_google, "walking", key)
transit_df <- map_df(times_vec, query_google, "transit", key)
all_df <- bind_rows(driving_df,
biking_df,
walking_df,
transit_df)
write_dta(all_df, "~/Dropbox/boston_tt.dta")
write_csv(all_df, "~/Dropbox/boston_tt.csv")
