# Custom functions -------------------------------------------------------------
# Custom functions that are useful in multiple scripts
return_unit_dir <- function(unit_name){
if(unit_name == "nbo_h3_res6"){
unit_dir <- file.path(data_dir,
"Unit Nairobi H3 Res 6")
}
if(unit_name == "nbo_h3_res7"){
unit_dir <- file.path(data_dir,
"Unit Nairobi H3 Res 7")
}
if(unit_name == "nbo_h3_res8"){
unit_dir <- file.path(data_dir,
"Unit Nairobi H3 Res 8")
}
if(unit_name == "nbo_h3_res9"){
unit_dir <- file.path(data_dir,
"Unit Nairobi H3 Res 9")
}
if(unit_name == "nbo_h3_res10"){
unit_dir <- file.path(data_dir,
"Unit Nairobi H3 Res 10")
}
if(unit_name == "nbo_adm1"){
unit_dir <- file.path(data_dir,
"Unit Nairobi ADM1")
}
if(unit_name == "nbo_adm2"){
unit_dir <- file.path(data_dir,
"Unit Nairobi ADM2")
}
if(unit_name == "static_sensors"){
unit_dir <- file.path(data_dir,
"Unit Nairobi Static Sensors")
}
if(unit_name == "pedestrians"){
unit_dir <- file.path(data_dir,
"Unit Nairobi Pedestrians")
}
return(unit_dir)
}
